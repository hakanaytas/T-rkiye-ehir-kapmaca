rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Oyuncu profilleri: herkes okuyabilir, sadece sahibi kendi profilini yazabilir.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // İller: herkes okuyabilir. "Ele geçirme" client-authoritative (v1) çalışır;
    // giriş yapmış herkes güncelleyebilir (basit, eğlence amaçlı sistem).
    match /provinces/{provinceId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Her ile ait GEÇİCİ sohbet mesajları.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null
                       && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Saldırı olayları: sadece animasyon/bildirim tetiklemek için kullanılır.
    match /attacks/{attackId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Emoji/nesne tepkileri: gönderen kısa süre sonra kendi kaydını siler.
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                     && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
