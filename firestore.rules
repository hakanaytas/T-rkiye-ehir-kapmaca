rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Oyuncu profilleri: herkes okuyabilir, sadece sahibi kendi profilini yazabilir.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // İller: herkes okuyabilir. Yazma işlemleri client-side transaction ile yapılır;
    // burada en azından "giriş yapılmış olmalı" ve "kendi ilini iddia etmeli" kontrolü var.
    // Not: Tam sunucu-taraflı doğrulama (ör. asker sayısı hile kontrolü) için
    // Cloud Functions + bu koleksiyona sadece Functions'ın yazması önerilir.
    match /provinces/{provinceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sohbet: giriş yapmış herkes okuyabilir/yazabilir, sadece kendi adına mesaj atabilir.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Bildirimler: sadece sahibi okuyabilir/işaretleyebilir; herkes (auth'lu) yeni bildirim yazabilir.
    match /notifications/{uid}/items/{itemId} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // İttifaklar
    match /alliances/{allianceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /allianceInvites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Savaş kayıtları: herkes okuyabilir, giriş yapmış herkes yazabilir (client-authoritative v1).
    match /wars/{warId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
