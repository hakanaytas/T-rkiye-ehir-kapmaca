rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Oyuncu profilleri: herkes okuyabilir, sadece sahibi kendi profilini yazabilir.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // İller: herkes okuyabilir. "Ele geçirme" client-authoritative (v1) çalışır;
    // giriş yapmış herkes güncelleyebilir (basit, eğlence amaçlı sistem).
    match /provinces/{provinceId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Her ile ait GEÇİCİ sohbet mesajları.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null
                       && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Saldırı olayları: sadece animasyon/bildirim tetiklemek için kullanılır.
    match /attacks/{attackId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Emoji/nesne tepkileri: gönderen kısa süre sonra kendi kaydını siler.
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                     && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // EK — Canlı "Olaylar" akışı: herkes okuyabilir, giriş yapan herkes olay ekleyebilir.
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // EK — Harita üstü kısa sohbet baloncukları: reactions ile aynı desen.
    match /bubbles/{bubbleId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                     && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // EK — Meydan okuma (mini oyun düellosu): basit, eğlence amaçlı; giriş yapan
    // herkes oluşturabilir/güncelleyebilir (client-authoritative, war.js/attack.js ile aynı yaklaşım).
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // EK — İller arası ittifak teklifleri/kayıtları.
    match /provinceAlliances/{allianceId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // EK — "Hazırım / Bitir" final tetikleyicisi (tek doküman).
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
